# Copy to the game folder as bfvr.ini (e.g. E:\EA\Battlefield 4\bfvr.ini).
# Environment variables BFVR_<KEY> override these values.

# Stage 1 virtual screen: 1 = on, 0 = load the DLL but leave VR off.
theater = 1

# OpenXR runtime:
#   auto     SteamVR when it is running (Steam Link), otherwise the Windows default (Meta Horizon Link)
#   system   always the Windows default runtime
#   steamvr  always SteamVR
#   <path>   any runtime manifest, e.g. a simulator: C:\Tools\MetaXRSimulator\meta_openxr_simulator.json
xr_runtime = auto

# Offer BF4 a fake XInput pad at start-up so the VR controllers work without a physical pad
# plugged in (re/notes/gamepad.md). 0 = only a real pad makes BF4 read the controllers.
virtual_pad = 1

# Stage 2: alternate-eye stereo with head tracking (replaces the virtual screen once both eyes
# have an image). Experimental; set to 0 to return to theater mode.
stereo = 0
# Also apply the eye pose to the first-person pass camera (view params +0xED0), so the gun stays
# where the soldier aims while the head looks around (re/notes/first_person.md). 0 = gun follows the head.
stereo_first_person = 1
# Per-eye image shape: headset = render each eye at the headset's own aspect (anamorphic 16:9
# image covering exactly the lens FOV, re/notes/camera.md); game = the window's 16:9 (wider than the lens).
stereo_aspect = headset
# Part of the headset's reported FOV that is rendered (0.4-1, tangent space). The Quest 3 via
# Steam Link reports more than its lenses show; cropping makes the visible image sharper. Too
# small shows black edges. Tune in the headset (pipe: viewcrop <h> <v>).
view_crop_h = 1.0
view_crop_v = 1.0
# Degrees cut off the bottom of the rendered view (0-30); the top edge stays and each eye's camera
# tilts up by half. The Quest 3 shows about 44 degrees up but only ~30 down, so the lines below are
# wasted: 14 here puts them where the lens looks (about 28 % sharper vertically at view_crop_v 0.72).
# Too much shows a black band at the bottom of the view.
view_crop_bottom = 0
# Fixed foveated rendering (NVIDIA GPUs, Turing or newer): the outer part of each eye's image is shaded
# once per 2x2 (and in the corners 4x4) pixels; the middle stays at full rate. off | light | medium |
# strong. Monitor, 2160x2160 per eye: off 102 fps, light 116, medium 123, strong 130; medium and strong
# show blocky highlights at the very edge.
foveation = light
# The gun keeps its animated grip in the right hand (its bones hang from Wep_Root, not the hand).
arm_ik_weapon = 1
# Wrist relative to the controller grip pose (metres, grip axes: -z along the handle, right hand;
# mirrored for the left). Tune in the headset.
arm_ik_wrist = 0 0 0.06
# Direction the elbows point from the shoulders (camera axes x right, y up, z back; right arm).
arm_ik_pole = 0.5 -1 0.3
# The game's arms can be shorter than yours (arm_length below scales them always). A hand still out
# of reach then moves the shoulder forward up to shoulder_reach metres, and the arm may get up to
# arm_stretch longer (0.25 = 25 %); 0 = off. Pipe `arms` shows reach (above 1 = out of reach). #31.
shoulder_reach = 0.12
arm_stretch = 0.25

# Comfort vignette (issue #10): darkens the edge of the view while the game turns or moves you (stick
# turning and aiming, walking, vehicles; never your own head): off | turning | moving | both, and how
# far it closes in. Seated play needs no setting: recenter while seated (the view starts at your head).
vignette = off
vignette_strength = 0.7

# Render size for the eye images (re/notes/render-quality.md). 0 = the monitor's mode (1920x1080).
# <w>x<h> offers the game a virtual fullscreen mode of that size (the window stays monitor-sized and
# shows a scaled preview). 2160x2160 runs at the 120 fps VR cap on an RTX 5070.
render_size = 0
# With render_size: ignore the game leaving fullscreen. Experiment: the game then resizes to its
# windowed size anyway, so leave it at 0.
keep_fullscreen = 0
# Hide focus loss from the game, so it keeps rendering at full rate and resolution when the SteamVR
# dashboard, Steam Link or another window takes focus. 0 = the game's own behaviour.
keep_focus = 1
# The game's HUD on its own head-locked layer instead of inside each eye image: sharp, inside the
# visible lens area, no HUD in the lens corners. 0 = HUD in the image (old behaviour).
hud_layer = 1
# Distance and width of the HUD layer in metres (1.3 m at 1.5 m is about 47 degrees wide).
hud_distance = 1.5
hud_width = 1.3
# #156: the HUD in front of you moved, cm (right, up).
hud_right = 0
hud_up = 0
# While the game moves the camera by itself (cutscenes: mostly first person, the camera riding the
# soldier's animated head; the death fall): screen = shown on the flat virtual screen; look = 3D, your
# head looks around inside the scene while the game moves you. Detected when the camera turns away
# from the aim for a quarter second, or the soldier is dead or absent; pipe `cutscene` shows it.
cutscene_view = screen
# In cutscenes (look): the arms, gun and fingers as the game animates them (game), or following your
# controllers as in play (controllers; the scene's animated body then fights them: hands reversed).
cutscene_hands = game
# Stream view, for recording with OBS (docs/TOOLING.md "Recording"): while the headset shows the
# level, the game window shows the left eye re-aimed at a steadied camera: yaw and pitch follow the
# head through a low-pass, the roll is taken out, 16:9 and stream_fov degrees across, letterboxed into
# the window. Menus, loading screens and flat-screen cutscenes stay the game's own picture.
# stream_smoothing: seconds to settle while the head is held still (turns are followed closer);
# 0 = no steadying (still level and 16:9). stream_hud: the HUD layer drawn into it. Pipe `stream`.
stream_view = 1
stream_fov = 80
stream_smoothing = 0.3
stream_hud = 1
# Right stick (issue #22): look = the game's aiming stick; turn = horizontal turns the view (snap or
# smooth), vertical flicks change stance (down: stand > crouch > prone, up: back). Switch live with
# pipe `rightstick look|turn`.
right_stick = turn
turn = snap
snap_turn_degrees = 30
stance_flicks = 1
# Physical stance: crouch (head ~30 cm below standing) or lie down (~85 cm) in the room and the soldier
# does too; the view then follows your real head only (the game's own crouch drop is added back).
# Standing is the highest your head has been since switching it on. Off by default: seated players
# would be crouched all the time. Stick flicks still work in between. Pipe `stance` shows it.
physical_stance = 0
# Gun hand (issue #9): left mirrors the controllers (sticks, triggers, grips, A/B <-> X/Y, stick
# clicks) and swaps the hand roles (gun arm, aim, ammo gesture; minimap on the right forearm).
dominant_hand = right
# Controller mapping: which pad button each Quest button presses (the game and the mod both follow it).
# controls_preset = default | jump_on_b (A reloads, B jumps) | custom; choosing a preset writes the
# bind_ lines, changing one of them makes it custom. Weapons change at the holsters (#48): no preset
# puts the game's weapon switch (y) on a button; Y gives the fire mode.
# bind_* values: a b x y lb rb left_stick right_stick start back dpad_up dpad_down dpad_left dpad_right
# none. Pad meanings: a jump, b reload/magazine release, x the game's menu, y switch weapon, lb grenade,
# left_stick sprint, right_stick melee, start pause (held: the bf-vr panel), dpad_up laser/light/
# magnifier, dpad_down fire mode, dpad_right attachment. Grips, triggers and sticks keep their roles.
# On the physical buttons: with dominant_hand = left the mirror swaps the roles afterwards.
controls_preset = default
bind_a = a
bind_b = b
bind_x = x
bind_y = dpad_down
bind_left_stick = left_stick
bind_right_stick = right_stick
bind_menu = start
# Reload (issue #14): button = the game's reload; physical = by hand. AK-pattern rifles: grip the
# magazine with the off hand to pull it, rack the slide when empty. Others (AR): X releases the magazine
# (caught if the off hand holds it), X again chambers after a new one when the bolt locked open. New
# magazines from the chest (grip there), let go at the chest to stow one. The ammo counter reads 2 high.
reload = physical
# Belt-fed LMGs and the revolver keep the game's own reload (B) until their own hand reloads exist
# (docs/tasks/all-weapons.md); 1 = the box-magazine hand reload for them too, as before. (Shotguns: shells_by_hand.)
physical_reload_all = 0
# Bolt actions (SRS, FY-JS, Scout, SV-98) and the Hawk's pump: after each shot grab the bolt knob or the fore-end,
# pull it back and let go before the next shot (the trigger waits); 0 = the game cycles them by itself.
manual_cycle = 1
# Tube shotguns (870, M1014, SPAS-12, QBS-09, UTAS): a shell from the pouch pushed into the loading port under the gun,
# one at a time, then pump (or rack) to chamber; 0 = the game's own reload (B).
shells_by_hand = 1
# Belt-fed LMGs (M249, M240, MG4, Pecheneg, Type 88): swing the lid up by its back end, B with the hand under the box
# takes it off, a new box from the pouch, the belt end laid on the feed tray, the lid pushed shut; 0 = the game's (B).
belts_by_hand = 1
# The MP-412 REX revolver: B breaks it open (the cases fall out), a speedloader from the pouch at the open cylinder,
# a flick of the gun up or a push on the barrel shuts it; 0 = the game's own reload (B).
revolver_by_hand = 1
# Physical reload: a dropped magazine loses its rounds (0 = they go back into the reserve).
drop_discards_ammo = 1
# AR palming (#40): a new magazine held beside the seated one turns aside in the hand, B catches the old one in
# the same hand and the new one goes in. Off by default for now (owner, 2026-11-22): B drops the old one.
magazine_palming = 0
# Physical reload: the magazine zone runs from the low chest pouch down to the off-side hip (#57); a
# magazine is grabbed or stowed with the off hand within this many metres of it.
magazine_reach = 0.13
# Pose editor (development, panel page Skeleton): pose_edit picks a grip (relaxed, reach, fist, cup, palm,
# magazine_ak, magazine_ar, hook, pinch, underhand); the pose_<finger>_bend / _side and pose_thumb_across / _out
# sliders are that grip's finger tweaks in degrees, added live on top of what it draws wherever a hand shows it.
# pose_show = left or right holds that hand in the grip while you tune it. pose_file = save writes all grips to
# bfvr_poses.ini beside this file (read at start), load reads it back. Pipe `poses` prints the live tweaks.
pose_edit = off
pose_show = off
pose_file = keep
pose_thumb_bend = 0
pose_thumb_side = 0
pose_index_bend = 0
pose_index_side = 0
pose_middle_bend = 0
pose_middle_side = 0
pose_ring_bend = 0
pose_ring_side = 0
pose_pinky_bend = 0
pose_pinky_side = 0
pose_thumb_across = 0
pose_thumb_out = 0
# Grenades (docs/tasks/grenades.md): button = the game's LB throw; physical = take one at the belt with
# the off-hand grip, pull the pin with the gun hand (grip next to the grenade, pull away), throw by
# letting go while the arm moves. Launch speed = hand speed x grenade_throw_scale.
# Draw every grab zone (magazine, charging handle, chest pouch, handguard, holsters) as a ring as large
# as its reach, green while a hand is inside: for finding the spots and for tuning them.
grab_debug = 0
# Grab zones tuned per gun (panel Weapon > Tune grab zones): zone_edit picks a zone of the gun in your hand (handle =
# charging handle, bolt or pump; magazine = the magazine or a shotgun's loading port; lid = a machine gun's lid or the
# revolver's frame) and the rings show; zone_right / zone_up / zone_forward move it in centimetres seen from behind the
# gun, zone_size scales it. Another gun in the hand puts its own values on the sliders. zone_file = save writes every
# gun to bfvr_zones.ini beside this file (load undoes unsaved changes, reset puts the zone back as built).
# zone_tunes = 0 uses every gun as built, to compare.
zone_edit = off
zone_right = 0
zone_up = 0
zone_forward = 0
zone_size = 1
zone_file = keep
zone_tunes = 1
# A real gamepad on the first XInput slot also reaches the game. Off: only the VR controllers (a pad
# with a worn or half-pressed trigger there fires the gun on its own; pipe status shows physical_pad).
physical_pad = 1
# The controller grips are the mod's (holding the gun, reload, grenades, holsters, signals); 1 also
# sends them to the game as LB/RB (grenade throw, and fire in some layouts).
grips_to_game = 0
# How far a trigger is pulled (0..1) before the game sees it pressed; released 0.1 below. A finger resting
# on the Quest trigger reads 0.25-0.5, which used to fire the gun.
trigger_press = 0.55
# Left trigger = the game's aim down sights (zooms the view, uncomfortable in VR).
ads_trigger = 0
# Single HUD elements on (1) or off (0), hidden by the game itself, so they disappear everywhere (issue
# #28): the game's crosshair (aim with the sights), hit markers, the red damage-direction arcs,
# objective markers and hints, interaction prompts (pick up, open), score pop-ups and awards, and the
# markers in the world (squad names and triangles over your companions).
hud_show_crosshair = 0
hud_show_hit_markers = 0
hud_show_damage = 0
hud_show_objectives = 1
hud_show_prompts = 1
hud_show_score = 0
hud_show_markers = 1
# Whole regions of the HUD layer: everything above the minimap and ammo, the minimap with its
# objective text, the ammo and grenade counter, the weapon and stance icons at the bottom.
hud_show_main = 1
hud_show_minimap = 1
hud_show_ammo = 1
hud_show_bottom = 0
# The minimap on the off-hand wrist (hud_mode = body, #55) shows only on a deliberate watch glance: the
# head at least hud_watch_pitch degrees down, the inner wrist within hud_watch_reach metres of the eyes
# and turned to them within hud_watch_facing degrees, held hud_watch_dwell seconds. Never while the off
# hand holds the gun, a magazine or a grenade.
hud_watch_pitch = 25
hud_watch_reach = 0.5
hud_watch_facing = 40
hud_watch_dwell = 0.25
# Health, ammo and grenades at the gun (hud_mode = body, #56): magcheck = roll the gun upside down (at
# least hud_magcheck_roll degrees) and look at the magazine, steady for hud_magcheck_hold seconds;
# side = turn its side to you and hold it a second (#26); both. They stay until you look away.
hud_ammo_gesture = magcheck
hud_magcheck_roll = 120
hud_magcheck_hold = 0.4
hud_ammo_width = 0.12
# #156: the forearm minimap: size (metres), cm from the wrist towards the elbow, cm around the arm towards the thumb;
# the gun counters moved, cm (right, up, forward along the barrel). With the VR panel open both stay shown.
hud_watch_width = 0.12
hud_watch_along = 12
hud_watch_side = 3
hud_ammo_right = 0
hud_ammo_up = 0
hud_ammo_forward = 0
# A magazine in the off hand (pulled from the gun or taken from the pouch, reload = physical) shows its
# own rounds ("27 / 30") beside it while you look at it, away from the magwell (#56).
hud_magazine_check = 1
# Body calibration (#46, #50): after a level loads, stand straight, arms out to the sides, and hold both
# triggers for two seconds. It measures your height (from the floor, or from the arm span without one, or
# when the floor is 30 cm or more off from the span) and span, sets body_height, body_span,
# arm_length and shoulder_width, and saves them here. A height more than 5 cm from the stored one is
# kept only when a second T-pose agrees. first = until done once (body_height 0 asks again), always =
# every level, off. body_height scales the pouches, holsters, sling and the shoulders (1.78 = as laid
# out). body_calibrate_now = 1 (panel: Calibrate now) or pipe `calibrate start` asks again now.
body_calibration = first
body_calibrate_now = 0
body_height = 0
body_span = 0
# Body size by hand (#50), metres, 0 = from body_height: shoulder joints below the eyes (0.22 at 1.78 m),
# chest pouches and knife in front of the eyes (0.10), hip holsters below the eyes (0.75).
shoulder_drop = 0
# The drawn shoulders moved back towards you (+) or forward (-), metres (headset 2026-11-14: they sat a
# little ahead). Their height is shoulder_drop.
shoulder_back = 0
chest_depth = 0
hip_drop = 0
# First-person arms: reach (forearm and hand scaled) and shoulders moved outwards (metres per side).
arm_length = 1.15
shoulder_width = 0.0
# First-person legs hidden (they sit oddly under a tracked head).
hide_legs = 1
# The soldier's collision radius in metres (#53); 0 = the game's 0.35. Smaller lets you walk up to a wall
# and lean out of a window. Applied when the soldier spawns (a level's first spawn included); a change in a
# level applies at the next respawn or checkpoint restart. Only the player's soldier. Pipe `radius` reports it.
soldier_radius = 0
# The off hand's wrist when it is not on the gun: neutral = the gun hand's grip mirrored, i.e. how you
# hold the controller (a held magazine stands upright in the fist); animated = the game's handguard
# hold turned by the controller. Monitor-checked 2026-11-03; the headset decides (H1).
off_hand_pose = neutral
# The gun hand while the off hand carries the gun, or holding the hand grenade or the C4 detonator: neutral = the gun
# grip as you hold the controller (like the free off hand), animated = the game's own hold turned by the controller.
# Launchers in gadget slots (M320) keep their own hold.
gun_hand_pose = neutral
# Racking: fist (default) = the knob in a closed fist, overhand when grabbed beside or above the handle,
# underhand from the larger zone below it (grab_debug draws both), the hand locked on the knob to the release;
# pinch = the charging handle's knob between the thumb and the side of the index (a key pinch;
# the thumb closes until it touches the knob); hook = the knob inside the curled index; auto = by how
# the hand takes the handle: palm down on it (overhand) pinches, palm up under it (underhand) hooks the
# knob in the index and middle. Kept for the stroke. Pipe `fingers` shows the hold and the palm reading.
rack_grip = fist
# #136: with no weapon out (the unarmed walks), both wrists turn in this many degrees about the controller ray, thumbs towards the torso.
empty_hand_turn = 80
# Two-handed: the off hand stays on the handguard where it grabbed until you let go (support_lock = 0: it slides
# with the controller), within support_slide_back (towards the magazine) and support_slide_forward (towards the
# muzzle) metres of the game's own handguard spot.
# #91: a gun with a foregrip (vertical, folding, angled, potato, stubby): the off hand holds the grip where the game's
# own hand does, with its grip pose, instead of sliding along the handguard. Pipe `sightstate` names the grip,
# `arms` shows on_grip.
# Pistols and the revolver: close the off hand round the gun hand to hold them with both hands, aim steadied by both
# (0: one-handed only) (#99).
# #62: the free hand is drawn on the gun's surface, never inside its receiver or handguard (the boxes come from the
# gun's own bones); a fast slap through the gun ends on the side it came from. Pipe `fingers` shows the contact.
# #65: the muzzle flash, its smoke and sparks drawn at the gun in your hand; the game draws them where its own flat gun
# would be (in front of your chest). Pipe `flash` shows the state, `flash survey <ms>` / `flash check <n>` research them.
# #92: the weapon's flashlight and laser light shine where the gun in your hand points. The game re-bases them from its
# own camera into your view, which turned them with your head (the spot off to the side you looked). Pipe `fplight`.
support_slide_back = 0.06
support_slide_forward = 0.08
# rack_grip fist: where the fist sits against the charging handle's knob (metres, the gun's frame): overhand out on
# the handle's side and up, underhand out and down, so it holds the knob from outside the gun. Panel page Skeleton.
rack_over_out = 0.005
rack_over_up = 0.005
rack_under_out = 0.005
rack_under_down = 0.005
# Sounds for magazines, chambering, grenade pouch and pin; a WAV in bfvr_sounds replaces one
# (cloth, magazine_in, magazine_out, chamber, pin .wav). For assault rifles the game's own magazine and
# bolt sounds play where they are found (#30). tools\game_cues.py installs the steps the game has no event for from
# its own files: bfvr_sounds\<gun's sound folder>\bolt_back.wav (the rack's rear stop), cloth.wav, pin.wav, M320\.
reload_sounds = 1
# #82: loudness of the grenade pin pull (0 silent .. 1 full); a bfvr_sounds\pin.wav still replaces the sound.
pin_volume = 0.35
# Throw strength: launch speed = hand speed x this (0.5..6). Owner 2026-11-24: 1.5 threw accurately but short.
grenade_throw_scale = 2.5
# Research only (Advanced page): aim = head lets the view aim the gun (the game's own way) and
# gun_pose = animated draws the game's hip pose turned by the controller; tools/sight_probe.py needs
# both to read the game's own sight pose. Play with controller / aim.
aim = controller
gun_pose = aim
# Left stick forward walks where your head faces (head), where the gun points (gun), or along the
# body like the game does (body; turning in the room then walks the old way).
move_direction = head
# Sprint and vault where you look (#52, with move_direction = head): click the left stick with the stick
# forward to sprint, or jump while pushing forward to vault; the soldier (not the view) turns to where
# you go, so the game gets the straight push it needs. The gun is lowered in a sprint anyway; firing,
# letting go of the stick or pushing more than 60 degrees aside ends it.
# Driving a car: wheel (default) = squeeze the grips to hold a steering wheel in front of you and turn it, the
# right trigger is the throttle and the left brakes and reverses (the left stick still drives while the wheel is
# let go); stick = the left stick drives as on a pad (forward throttle, back brake and reverse, sideways steers).
# In either mode the view rides with the car and the right stick rests (look with your head).
drive_controls = wheel
# With drive_controls = wheel: wheel turn for full steering, degrees (45-360).
wheel_lock_degrees = 90
# The gun aims with the gun-hand controller: bullets leave the drawn gun along its barrel and land on
# its sight's dot; the game's own aim stays with the body. Off hand + grip on the handguard holds the
# gun with both hands, the barrel on the line between them (pipe `twohand`).
# A dot on what the barrel points at, where the shots go, and its size in degrees (the game's crosshair,
# hud_show_crosshair, marks the head's aim, not the gun's).
# Recoil: the drawn gun kicks per shot (muzzle up about the wrist and a little sideways, back along the
# barrel), full auto climbs, and it settles back to the controller in ~0.2 s; a support hand on the
# handguard halves it. Each gun kicks by its own game data (the SCAR-H harder and slower than the
# AK-12, a bigger first shot). 0 = off, up to 3. The controller and the view do not move; the shots
# follow the kicked gun, as with a real one.
# A long gun (rifle, shotgun, LMG, sniper rifle; the game's own pistol animation set is left out) fired
# without the support hand on the handguard: about 5x the climb of a two-handed shot, 2.5x the push back,
# thrown about shot by shot and slower to settle, as in the BF3 VR mod (#60). 0 = the plain one-handed kick.
# Hold the gun's sight to an eye (within 3 cm of its line, up to 30 cm behind it) and the game aims
# down the sights: the optic's lens clears (it is opaque at the hip) and the game's ADS accuracy and
# slower walk apply; it ends 0.3 s after both eyes are more than 5 cm off the line. 0 = never
# (ads_trigger still gives LT by hand): sights stay live through sight_dot, the SCAR's holo window is
# clear without the game's aim, the AK-12's red dot lens stays black. A gun whose only optic is a clear
# holo (the SCAR's EOTech) skips the game's aim while hip_accuracy is 1: no game reticle over the dot,
# full walking speed.
# Guns with an optic: a red dot at infinity along the sight line, seen only by the eye that looks
# through the lens, aiming or not, like a real reflex sight (the game draws its own reticle at the
# centre of the view, which only lines up when the head looks exactly down the barrel). sight_dot_size: degrees.
# How far off the sight line (cm) an eye still sees the dot: the lens is about 1.5, more forgives an
# unsteady hold. sight_dot_test = 1 shows the dot to both eyes wherever the gun is held (a check that
# the headset shows the dot layer at all).
# A sight held to your eye shows the game's own aiming mesh of the gun and its optic (the clear lens and
# the optic's own reticle) without the game aiming: no slower walk, no zoom. Works from the weapon's
# data, for every gun and optic.
# While a sight is at your eye the game's own reticle stays on the sight line when your head turns, the
# same in both eyes (the game anchors it to the centre of the view, where it leaves the lens).
# sighting = only the eye behind the sight sees the dot; both = one layer for both eyes (try it if the
# dot never shows at one eye).
# Every gun in the campaign weapon crate can be picked, locked or not. Holds the game's own
# all-unlocked switch (SyncedBFSettings.AllUnlocksUnlocked) while a campaign level runs and puts the
# game's value back when the level ends; memory only, nothing is saved or sent to EA.
unlock_all_weapons = 1
# Own crate (#80): pick a gun on the VR panel (Weapon > Weapons) and it goes into that slot and into your hand about a second
# after you stop stepping, without the game's weapon crate. keep = no change; a value here is not applied at start, only a change is.
crate_primary = keep
crate_secondary = keep
# Hip-fire spread of your weapons (standing, crouched, prone; still and moving): 1 = as tight as aiming
# down sights, so a sight is accurate without the game's aim; 0 = the game's (3-7 degrees at the hip,
# 0.2-1.7 aiming). Patches the weapons' GunSwayData in memory; enemies carrying the same gun model may
# share it. Linear in between: the AK-12/SCAR-H cone standing still (min..max degrees, a burst grows
# towards max) is 0.2..1.7 at 1, 0.9..3.0 at 0.75, 1.6..4.4 at 0.5, 2.3..5.7 at 0.25, 3..7 at 0.
# Headset 2026-11-11: 1 is pin-point on full auto; lower it for more spread.
hip_accuracy = 1
# Magnifying sights (the AK-12's flip magnifier): while the game aims through one, the world is
# rendered once more from the sight with the lens's narrow view and shown on the lens, with a red dot
# on the sight line. Costs one extra world render while aiming. scope_zoom multiplies the game's own
# magnification (the magnifier: 1.7x).
scope_zoom = 1
# Red dots and holos as a real sight (the BF3 single-player mod's lens): the game's reticle art placed by the
# angle through the glass, so it keeps its true size at any distance, turns with the gun, not your head, and
# the optic's glass is clear while you look into it (the game's aiming mesh, within sight_lens_cone below).
# sight_lens_fov: the aiming view the art is sized for, degrees; 0 = the reticle's own zoom level from the game's data
# (red dots and holos 40: the EOTech's ring as the real one; scopes their zoomed view; a flipped magnifier keeps its red
# dot's, so the ring grows with the power); 10 or more overrides.
# A held magazine sits as deep in the hand as the game's own hand takes that gun's magazine (a short one nearer its
# top, a long one deeper); 0 = every magazine as the SCAR-H's or AK-12's (#90).
# The game's aiming model of the optic (clear lens and reticle, but open at the top) shows only while an eye looks
# into the lens from behind within this many degrees of the sight line; elsewhere the full optic (0 = always).
sight_lens_cone = 8
sight_lens_fov = 0
sight_lens_brightness = 4
# When the barrel points at nothing (the sky), shots meet the barrel line this many metres away.
aim_convergence = 25

# VR controllers act as an Xbox pad (merged into the game's XInput slot 1). 0 = leave input alone.
gamepad = 1

# With the knife out, the blade points along the gun-hand controller (edge down); knife_pitch raises
# the blade this many degrees to lie on the ray (0 = the knife model's own angle).
knife_pitch = 145
# Further turns of the held knife, degrees: knife_yaw about the controller's up (+ = right), knife_roll about
# its ray (+ = clockwise seen from behind). Tune them on the panel (Weapon > Hands and melee).
knife_yaw = -15
knife_roll = 170
# Free hands: the gun hand's grip open this long (seconds) before the gun drops or goes to the off hand; 0 = at once.
free_hands_release = 0
# #41: the grenade and knife at their slots are drawn this far (metres) ahead of their grab spots, on the chest
# instead of inside it; the grab zones stay where they are.
slot_models_ahead = 0.08
# #41: the knife on the chest hangs blade down, handle up; this turns it about its blade, degrees:
# 90 = edge to your left, -90 = to your right, 0 = ahead.
knife_holster_turn = 90
# #151 (Body > Items on your body): the knife's tip (+ handle towards you) and sideways lean, degrees, and its
# place from the grab spot in cm (right, up, forward); the same for the grenade at its pouch, plus its turn.
knife_holster_tilt = 0
knife_holster_lean = 0
knife_holster_right = 0
knife_holster_up = 0
knife_holster_forward = 0
grenade_pouch_right = 0
grenade_pouch_up = 0
grenade_pouch_forward = 0
grenade_pouch_turn = 0
# With the C4 out, the off-hand trigger throws a pack (the game's aim button, otherwise held back by
# ads_trigger = 0); the gun-hand trigger on the detonator sets them off.
# #70: the squad order and a melee strike go where you look, a C4 throw along your off hand (the game's aim turns
# there for that moment; off: along your body).
# Controller vibration (issue #32): the game's rumble (firing on the gun hand, explosions and hits on
# both, firing on both while holding the gun two-handed) and short taps for holsters, magazines,
# grenades, the two-handed grab, use and menu clicks. Pipe `haptics` shows the game's motors.
haptics = 1
haptics_strength = 0.8

# A short tap of both thumbstick clicks (let go before the panel opens) marks the moment: a pulse,
# "Marked moment N" below the view, and the mod's state, live settings and a screenshot saved to
# bfvr_marks\mark-<time>-<N>.txt/.png beside bf4.exe, for headset feedback. Pipe: mark [note].
mark_tap = 1
# The panel's backdrop is see-through like the HUD: 0.2 (faint) .. 1 (opaque). Either controller's
# beam and dot show where it points.
panel_opacity = 0.6
# After a level loads, "Hold both sticks: VR settings" shows below the view for 8 s.
menu_hint = 1
